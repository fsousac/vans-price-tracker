{
  "name": "vans-alert",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.14"
  },
  "scripts": {
    "start": "node src/main.ts",
    "dev": "node --watch src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import ./tests/helpers/no-network.ts --test \"tests/{unit,contract,integration,e2e,security}/**/*.test.ts\"",
    "test:cov": "node --import ./tests/helpers/no-network.ts --test --experimental-test-coverage --test-coverage-lines=80 --test-coverage-branches=80 \"tests/{unit,contract,integration,e2e,security}/**/*.test.ts\"",
    "test:live": "node --test \"tests/live/**/*.test.ts\"",
    "db:migrate": "node src/db/migrate-cli.ts",
    "build": "node scripts/build.ts",
    "build:dev": "node scripts/build.ts --dev"
  },
  "dependencies": {
    "@hono/node-server": "2.1.5",
    "better-sqlite3": "13.0.3",
    "hono": "4.13.13",
    "nodemailer": "10.1.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/chrome": "0.3.5",
    "@types/node": "24.19.2",
    "@types/nodemailer": "8.0.2",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
